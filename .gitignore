# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Environment / secrets
.env
.env.local
*.pem

# Node
node_modules/
frontend/dist/
frontend/.vite/
frontend/tsconfig.tsbuildinfo

# Local data & media (never commit footage or biometric data).
# Anchored with a leading slash: a bare 'storage/' also matched
# backend/app/storage/, which silently kept a required source module out
# of the repository.
/storage/
models/*.pt
models/*.onnx
data/sample_videos/*
!data/sample_videos/.gitkeep
data/familiar_faces/*
!data/familiar_faces/.gitkeep

# Local dev database cluster
.devdb/
logfile

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/
