# =====================================================================
# Sentinel - environment configuration
# Copy to .env and fill in your values.  .env is gitignored.
# =====================================================================

# ------------------------------- Application -------------------------
APP_NAME=Sentinel
ENVIRONMENT=development
DEBUG=false
API_HOST=127.0.0.1
API_PORT=8600
LOG_LEVEL=INFO
LOG_JSON=false

# --------------------------------- Security --------------------------
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# -------------------------------- Database ---------------------------
# PostgreSQL, using the psycopg 3 driver.
DATABASE_URL=postgresql+psycopg://sentinel:CHANGE_ME@localhost:5432/sentinel
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --------------------------------- Storage ---------------------------
# Large media lives on disk; only metadata goes in PostgreSQL.
STORAGE_PATH=./storage
RECORDING_PATH=./storage/recordings
FACE_STORAGE_PATH=./storage/faces
SNAPSHOT_PATH=./storage/snapshots
EVENT_ASSET_PATH=./storage/events
VIDEO_STORAGE_PATH=./data/sample_videos
FACE_DATASET_PATH=./data/familiar_faces
MODEL_PATH=./models

# ---------------------------------- Models ---------------------------
# auto | cuda | cpu | mps.  'auto' uses a GPU when one is present.
AI_DEVICE=auto
# Models are fetched automatically on first use (also: python scripts/download_models.py)
AUTO_DOWNLOAD_MODELS=true
OBJECT_MODEL_NAME=yolo11n.pt
FACE_DETECTOR_MODEL=face_detection_yunet_2023mar.onnx
FACE_EMBEDDER_MODEL=face_recognition_sface_2021dec.onnx
DETECTION_CONFIDENCE=0.35
DETECTION_IOU=0.5
DETECTION_CLASSES=person,bicycle,car,motorcycle,bus,truck,cat,dog,horse,sheep,cow,bear,bird

# -------------------------------- Inference --------------------------
# Run the detector every N frames; tracking carries objects in between.
DETECTION_INTERVAL=3
TARGET_FPS=12
FRAME_MAX_WIDTH=960
# Frames before an already-identified track is re-verified.
RECOGNITION_COOLDOWN_FRAMES=45

# --------------------------------- Tracking --------------------------
TRACK_MAX_AGE=30
TRACK_MIN_HITS=3
TRACK_IOU_THRESHOLD=0.3

# ----------------------------------- Motion --------------------------
MOTION_MIN_AREA_RATIO=0.0015
MOTION_START_FRAMES=3
MOTION_END_FRAMES=25

# ------------------------------------ Face ---------------------------
# SFace's own reference operating point is ~0.363 cosine. Setting this much
# higher rejects genuine same-person pairs seen from a different angle.
FACE_RECOGNITION_THRESHOLD=0.40
FACE_MIN_PIXELS=40
FACE_MIN_BLUR=18.0
FACE_MIN_BRIGHTNESS=35.0
FACE_MAX_BRIGHTNESS=225.0
FACE_MIN_CONFIDENCE=0.7
# Yaw past this is "steeply angled". With the soft gate ON (default) such a
# face is still embedded and still contributes to the track's profile - it
# just has to clear a higher similarity bar. Set the soft gate to false to go
# back to discarding angled faces outright.
FACE_MAX_YAW_RATIO=0.38
FACE_POSE_SOFT_GATE=true
FACE_POSE_THRESHOLD_PENALTY=0.06
# Consecutive disagreeing observations needed to change a track's identity.
FACE_VOTES_TO_SWITCH_IDENTITY=3

# Detect faces once per frame and assign them to people one-to-one, rather
# than running a detector inside each person box (where the biggest face in
# somebody's box is frequently their neighbour's).
FACE_DETECT_WHOLE_FRAME=true
FACE_MAX_FACES_PER_FRAME=24
FACE_MIN_CONTAINMENT=0.55

# -------------------------------- Face profile -----------------------
# A track is identified from MANY views of its face, collected across pose
# and lighting buckets while the person is in the recognition zone - not from
# whichever frame happened to be processed last.
FACE_PROFILE_MAX_SAMPLES=100
FACE_PROFILE_MIN_SAMPLES=8
FACE_PROFILE_PER_BUCKET=8
# How many of those views are enrolled when an operator classifies the person.
FACE_PROFILE_GALLERY_SIZE=12
# Fraction of the profile that must agree before a verdict stands.
FACE_PROFILE_SUPPORT_RATIO=0.55
# Best identity must beat the runner-up by this cosine margin.
FACE_MATCH_MARGIN=0.05
FACE_PROFILE_REVERDICT_EVERY=3

# ---------------------------- Unknown confirmation -------------------
# An unknown person is NOT alarmed on immediately. Evidence is gathered for
# this long, across this many separate profile verdicts, before the system is
# willing to call somebody a stranger.
UNKNOWN_CONFIRM_SECONDS=12.0
UNKNOWN_CONFIRM_MIN_VERDICTS=3

# -------------------------------- Proximity --------------------------
# IMPORTANT: A is the RECOGNITION zone and must be FARTHER than B,
# the ALARM zone.  A > B > 0 is validated at startup.
DEFAULT_PROXIMITY_A=10.0
DEFAULT_PROXIMITY_B=3.0
REFERENCE_PERSON_HEIGHT_M=1.7
DEFAULT_VERTICAL_FOV_DEG=55.0

# --------------------------------- Identity --------------------------
TEMPORARY_FAMILIAR_DEFAULT_DAYS=7
EXPIRATION_SCAN_SECONDS=60

# ----------------------------------- Alerts --------------------------
# What a TEMPORARY familiar triggers: none | beep | continuous
TEMPORARY_FAMILIAR_ALERT=beep
# Whether an unrecognizable face inside the alarm zone alarms: ignore | alarm
# 'ignore' is the safe default: failing to recognise is not proof of an intruder.
ALARM_UNRECOGNIZABLE_POLICY=ignore
ALERT_REPEAT_SECONDS=30

# A confirmed unknown in the alarm zone gets a timed alarm that clears itself
# after ALARM_DURATION_SECONDS, then a quiet gap, and only escalates to an
# operator-cleared continuous alarm after this many cycles.
ALARM_DURATION_SECONDS=30
ALARM_ESCALATE_AFTER_CYCLES=3
ALARM_REARM_SECONDS=20
# Startup default for audible alarms. The operator's toggle in the console is
# persisted and wins after the first change. Turning sound off does NOT stop
# alarms being raised, recorded or displayed - it only silences them.
ALARM_SOUND_ENABLED=true

# --------------------------------- Recording -------------------------
RECORDING_ENABLED=true
RECORDING_FPS=15
RECORDING_FOURCC=mp4v
# Rotate to a new file after this many minutes (0 disables rotation).
RECORDING_MAX_MINUTES=30

# --------------------------------- Retention -------------------------
EVENT_RETENTION_DAYS=90

# =====================================================================
# Docker Compose only (ignored when running natively)
# =====================================================================
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=sentinel
POSTGRES_PORT=5432
# Host port for the dashboard when using docker compose.
WEB_PORT=8080
